# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
venv-deepface/
backend/.venv/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
*.local

# ── Secrets ──────────────────────────────────────────────────────────────────
# .env holds the NVIDIA API key and any production SECRET_KEY. Never commit it.
.env
*.env
!.env.example
!backend/.env.example

# ── Runtime data (regenerated on first run) ──────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/vitalband*.db

# ── Large binaries fetched by setup, not source ──────────────────────────────
# MediaPipe pose model (5.7 MB) — see vision/README for the download command.
vision/*.task
# Pre-rendered gTTS clips are regenerated by voice_alerts.py --pregenerate
voice/cache/*.mp3

# ── Build / tooling scratch ──────────────────────────────────────────────────
deck/media/
deck/preview-*.jpg
deck/*.pptx
build/
dist/
*.log

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
