# ── NVIDIA NIM (optional) ────────────────────────────────────────────────────
# Get a free key at https://build.nvidia.com  ->  any Nemotron model -> "Get API Key"
# Without this, explanations fall back to deterministic rule text. Nothing breaks.
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TIMEOUT=4.0
